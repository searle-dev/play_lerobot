+    def clamp_xy_target(self, x, y):
+        x = max(self.MIN_X, min(self.MAX_X, x))
+        y = max(self.MIN_Y, min(self.MAX_Y, y))
+
+        r = math.hypot(x, y)
+        r_max = self.kinematics.l1 + self.kinematics.l2 - self.WORKSPACE_MARGIN
+        r_min = abs(self.kinematics.l1 - self.kinematics.l2) + self.WORKSPACE_MARGIN
+
+        if r > r_max:
+            scale = r_max / r
+            x *= scale
+            y *= scale
+        elif 0 < r < r_min:
+            scale = r_min / r
+            x *= scale
+            y *= scale
+
+        x = max(self.MIN_X, min(self.MAX_X, x))
+        y = max(self.MIN_Y, min(self.MAX_Y, y))
+        return x, y
+
