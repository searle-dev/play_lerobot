# OpenAI-compatible LLM endpoint used by programs/llm_agent.py.
XLEROBOT_LLM_PROVIDER=openai-compatible
XLEROBOT_LLM_BASE_URL=https://zenmux.ai/api/v1
XLEROBOT_LLM_API_KEY=replace-with-your-api-key
XLEROBOT_MODEL=google/gemini-3.1-pro-preview
XLEROBOT_AGENT_HISTORY_LEN=6
XLEROBOT_LLM_VISUAL_HISTORY=1
XLEROBOT_THINKING_LEVEL=

# Optional hardware defaults used by programs/llm_agent.py.
# macOS/OpenCV usually uses numeric camera indexes. Linux udev setups can use paths.
XLEROBOT_MAIN_CAMERA=0
XLEROBOT_RIGHT_ARM=/dev/arm_right
XLEROBOT_LEFT_ARM=/dev/arm_left

# Optional VLA manipulation tool. Set XLEROBOT_VLA_POLICY_NAME to enable
# Manipulate_object in programs/llm_agent.py and the dashboard.
XLEROBOT_VLA_POLICY_NAME=
XLEROBOT_VLA_POLICY_TYPE=act
XLEROBOT_VLA_SERVER=0.0.0.0:8080
XLEROBOT_VLA_TASK_PROMPT=
XLEROBOT_RIGHT_CAMERA=0
XLEROBOT_POLICY_DEVICE=cpu
